@{
    ViewData["Title"] = "Clickjacking - Vulnerable";
}
<link rel="stylesheet" href="~/css/Clickjacking.css" />
<div>
    <div>
        <h2 class="text-center">CLICKJACKING DEMO SITE</h2>
    </div>
   
    <div class="container text-center">
        <h3>Example for Likejacking</h3>
        <p class="text-info fw-bold">If you want to win the game, click on me while the movement continues until the end.</p>
        <button class="btn btn-success text-white" id="click">click me</button>
        <iframe class="mt-3 youtube"
                width="560" height="315"
                src="https://www.youtube.com/embed/Nw7mY9gk2Jw?si=Du0UHbNoJXbGpFa3"
                title="YouTube video player"
                allowfullscreen>
        </iframe>
    </div>
    <div class="text-center mt-3">
        <h3>Demo form site for clickjacking</h3>
        <iframe class="mt-3" width="100%" height="500"
                src="http://localhost:5187/vulnerable/clickJacking/clickjackingdemo"
                allowfullscreen>
        </iframe>
    </div>
</div>