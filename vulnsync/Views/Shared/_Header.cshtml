<form asp-action="LoadBug" asp-controller="Home" type="post">
    <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-content-center">
            <label class="text-white mx-2 align-content-center" for="status">Status:</label>
            <select id="status" class="rounded form-control-sm" name="status">
                <option disabled selected>Select status</option>
                <option value="1">Vulnerable</option>
                <option value="2">Secure</option>
            </select>
        </div>
    
        <div class="d-flex align-content-center">
            <label class="text-white mx-2 align-content-center" for="bug">Bug: </label>
            <select id="bug" class="rounded form-control-sm" name="bugType">
                <option disabled selected>Select Bug</option>
            </select>
        </div>
    
        <div class="d-flex">
            <button class="btn btn-success btn-sm" type="submit">Load Bug</button>
        </div>
    </div>
</form>
