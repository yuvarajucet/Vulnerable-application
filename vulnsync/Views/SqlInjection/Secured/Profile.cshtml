@model object 

@{
    ViewBag.Title = "Profile";
    var users = Model as List<VulnSync.Models.IDOR.User>; // Try to cast as List
}

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 0;
    }

    .container {
        max-width: 600px;
        margin: 50px auto;
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    }

    .profile-header {
        background: #007bff;
        color: white;
        padding: 15px;
        border-radius: 8px 8px 0 0;
        text-align: center;
        font-size: 20px;
        font-weight: bold;
    }

    .profile-body {
        padding: 15px;
    }

    .profile-body p {
        margin: 10px 0;
        font-size: 16px;
    }

    .label {
        font-weight: bold;
        color: #333;
    }
</style>

<div class="container">
    <div class="profile-header">User Profile</div>
    <div class="profile-body">
        @if (users != null)
        {
            <!-- 🔴 SQL Injection triggered: Display all users -->
            foreach (var user in users)
            {
                <p><span class="label">ID:</span> @user.Id</p>
                <p><span class="label">Username:</span> @user.Username</p>
                <p><span class="label">Email:</span> @user.Email</p>
                <p><span class="label">Password:</span> @user.Password</p>
                <hr />
            }
        }
        else
        {
            <p style="color: red;">Error: No user data found.</p>
        }
    </div>
    <a href="javascript:history.back()" class="btn btn-secondary">Back</a>
    <a href="@Url.Action("SecuredLogout", "SqlInjection")" class="btn btn-danger logout-btn">Logout</a>
</div>
