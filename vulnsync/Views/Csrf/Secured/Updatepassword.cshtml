<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card p-4" style="background-color: #1f1f1f; color: #eaeaea; border-radius: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);">
                <div class="card-header text-center" style="background-color: #333; color: #ffcc00; border-radius: 8px 8px 0 0;">
                    <h2>Update Your Password</h2>
                </div>
                <div class="card-body">
                    <form asp-action="SecureUpdatePassword" method="post">
                        <div class="form-group">
                            <label for="newPassword" class="form-label">New Password</label>
                            <input type="password" class="form-control bg-dark text-white" id="newPassword" name="NewPassword" required>
                        </div>
                        <div class="form-group mt-3">
                            <label for="confirmPassword" class="form-label">Confirm New Password</label>
                            <input type="password" class="form-control bg-dark text-white" id="confirmPassword" name="ConfirmPassword" required>
                        </div>
                        <div class="d-flex justify-content-between mt-4">
                            <button type="submit" class="btn btn-outline-success text-white" style="color: #28a745; border-color: #28a745;">Update Password</button>
                            <a href="@Url.Action("Login", "Csrf")" class="btn btn-outline-danger text-white" style="color: #ff5e5e; border-color: #ff5e5e;">Logout</a>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center" style="background-color: #2a2a2a; border-radius: 0 0 8px 8px;">
                    <div class="text-danger">@ViewBag.ErrorMessage</div>
                </div>
            </div>
        </div>
    </div>
</div>
