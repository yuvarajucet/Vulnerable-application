@model VulnSync.Models.IDOR.User

@{
ViewData["Title"] = "User Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4" style="background-color: #1f1f1f; color: #eaeaea; border-radius: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);">
                <div class="card-header text-center" style="background-color: #333; color: #ffcc00; border-radius: 8px 8px 0 0;">
                    <h3>User Profile</h3>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-center mb-4">
                        <div class="avatar" style="width: 80px; height: 80px; background-color: #444; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ffcc00; font-size: 24px;">
                            @Model.Username.Substring(0, 1).ToUpper()
                        </div>
                    </div>
                    <p><strong>Username:</strong> @Model.Username</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                </div>
                <div class="card-footer d-flex justify-content-between" style="background-color: #2a2a2a; border-radius: 0 0 8px 8px;">
                    <a href="@Url.Action("UpdatePassword", "Csrf")" class="btn btn-outline-warning text-white" style="color: #ffcc00; border-color: #ffcc00;">Update Password</a>
                    <a href="@Url.Action("Login", "Csrf")" class="btn btn-outline-danger text-white" style="color: #ff5e5e; border-color: #ff5e5e;">Logout</a>
                </div>
            </div>
        </div>
    </div>
</div>



