@model VulnSync.Models.IDOR.User

@{
ViewData["Title"] = "User Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">l
            <div class="card">
                <div class="card-header text-center">
                    <h3>User Profile</h3>
                </div>
                <div class="card-body">
                    <p><strong>Username:</strong> @Model.Username</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                </div>
                <div class="card-footer text-center d-flex justify-content-end">
                    <a href="@Url.Action("VulnerableUserDetails", "IDOR", new { userId = @Model.Id })" class="btn btn-warning me-3">Advanced settings</a>
                    <a href="@Url.Action("Login", "IDOR")" class="btn btn-danger">Logout</a>
                </div>
            </div>
        </div>
    </div>
</div>

