@model VulnSync.Models.IDOR.User

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h2 class="mb-0">User Details</h2>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-center mb-4">
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 100px; height: 100px; font-size: 30px;">
                            @Model.Username.Substring(0, 1).ToUpper()
                        </div>
                    </div>
                    <h4 class="text-center mb-4">@Model.FullName</h4>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <strong>Email:</strong> @Model.Email
                        </li>
                        <li class="list-group-item">
                            <strong>Username:</strong> @Model.Username
                        </li>
                        <li class="list-group-item">
                            <strong>Date of Birth:</strong> @Model.DateOfBirth.ToString("yyyy-MM-dd")
                        </li>
                        <li class="list-group-item">
                            <strong>Phone Number:</strong> @Model.PhoneNumber
                        </li>
                        <li class="list-group-item">
                            <strong>Address:</strong> @Model.Address
                        </li>
                    </ul>
                </div>
                <div class="card-footer text-center">
                    <button class="btn btn-warning me-2">Edit Details</button>
                    <button  class="btn btn-danger">Delete User</button>
                </div>
            </div>
        </div>
    </div>
</div>
