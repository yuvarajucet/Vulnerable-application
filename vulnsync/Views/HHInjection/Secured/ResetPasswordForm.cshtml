@{
    ViewBag.Title = "Set New Password";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4" style="background-color: #1f1f1f; color: #eaeaea; border-radius: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);">
                <div class="card-header text-center" style="background-color: #333; color: #ffcc00; border-radius: 8px 8px 0 0;">
                    <h3>Set New Password</h3>
                </div>
                <div class="card-body">
                    <form method="POST" asp-action="ResetPassword">
                        <input type="hidden" name="token" value="@ViewBag.Token" />
                        <input type="hidden" name="email" value="@ViewBag.Email" />

                        <div class="mb-4">
                            <label for="newPassword" class="form-label">New Password</label>
                            <input type="password" id="newPassword" name="newPassword" class="form-control" placeholder="Enter new password" required style="background-color: #444; color: #eaeaea; border: 1px solid #666;">
                        </div>

                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label">Confirm Password</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Confirm new password" required style="background-color: #444; color: #eaeaea; border: 1px solid #666;">
                        </div>

                        <button type="submit" class="btn btn-outline-warning w-100" style="color: #ffcc00; border-color: #ffcc00; transition: color 0.3s; text-decoration: none;" 
                            onmouseover="this.style.color='white';" onmouseout="this.style.color='#ffcc00';">
                            Reset Password
                        </button>
                    </form>
                </div>
                <div class="card-footer d-flex justify-content-between" style="background-color: #2a2a2a; border-radius: 0 0 8px 8px;">
                    <div class="text-danger">@ViewBag.ErrorMessage</div>
                </div>
            </div>
        </div>
    </div>
</div>
