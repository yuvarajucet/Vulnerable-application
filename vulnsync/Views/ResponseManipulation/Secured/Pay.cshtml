@model VulnSync.Models.Vulnerable.ResponseManipulation.OrderSummaryViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="~/css/ResponseManipulation.css" />
    <title>@ViewData["Title"] - Response Manipulation</title>
</head>
<body>
<div class="header-container">
    <h1>Response Manipulation E-commerce</h1>
    <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="@Url.Action("SecuredProduct", "ResponseManipulation")">Products</a></li>
            <li><a href="@Url.Action("SecuredCart", "ResponseManipulation")">Cart</a></li>
            <li><a href="/Contact">Contact Us</a></li>
            <li><a href="/About">About Us</a></li>
        </ul>
    </nav>
</div>
<h2>Payment Information</h2>

<form asp-controller="ResponseManipulation" asp-action="PaymentVerification" method="post" class="checkout-form scrollable-section" onsubmit="return validateForm()">
    <p>Total Items: @Model.TotalItems</p>
    <p>Total Price: $@Model.TotalPrice</p>

    <!-- Hidden fields to retain values -->
    <input type="hidden" name="TotalItems" value="@Model.TotalItems" />
    <input type="hidden" name="TotalPrice" value="@Model.TotalPrice" />
    <input type="hidden" name="Name" value="@Model.Name" />
    <input type="hidden" name="Address" value="@Model.Address" />
    <input type="hidden" name="Email" value="@Model.Email" />

    <div class="form-group">
        <label for="cardNumber">Card Number:</label>
        <input type="text" id="cardNumber" name="CardNumber" required class="form-control"
               pattern="^\d{16}$" maxlength="16" title="Please enter a valid card number (16 digits)." />
    </div>

    <div class="form-group">
        <label for="expiryDate">Expiry Date (MM/YY):</label>
        <input type="text" id="expiryDate" name="ExpiryDate" maxlength="5" required class="form-control"
               placeholder="MM/YY" pattern="^(0[1-9]|1[0-2])\/([0-9]{2})$"
               title="Please enter a valid expiry date (MM/YY)." />
    </div>

    <div class="form-group">
        <label for="cvv">CVV:</label>
        <input type="text" id="cvv" name="CVV" maxlength="3" required class="form-control"
               pattern="^\d{3,4}$" title="Please enter a valid CVV 3digits." />
    </div>

    <button type="submit" class="btn btn-primary">Submit Payment</button>
</form>

<script src="~/js/ResponseManipulation/site.js" ></script>
</body>
</html>