@model VulnSync.Models.Vulnerable.ResponseManipulation.OrderSummaryViewModel

@{
    ViewData["Title"] = "Checkout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="~/css/ResponseManipulation.css" />
    <title>@ViewData["Title"] - Response Manipulation</title>
</head>
<body>
<div class="header-container">
    <h1>Response Manipulation E-commerce</h1>
    <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="@Url.Action("Product", "ResponseManipulation")">Products</a></li>
            <li><a href="@Url.Action("Cart", "ResponseManipulation")">Cart</a></li>
            <li><a href="/Contact">Contact Us</a></li>
            <li><a href="/About">About Us</a></li>
        </ul>
    </nav>
</div>
<main>
    <h2 class="text-center">Checkout</h2>

    @if (Model != null)
    {
    <form asp-controller="ResponseManipulation" asp-action="Payment" method="post" class="checkout-form scrollable-section">
        <h4 class="text-center">Billing Information</h4>
        <h3 class="text-center">Order Summary</h3>
        <p class="summary-text">Total Items: @Model.TotalItems</p>
        <p class="summary-text">Total Price: $@Model.TotalPrice</p>

        <!-- Hidden fields for TotalItems and TotalPrice -->
        <input type="hidden" name="TotalItems" value="@Model.TotalItems" />
        <input type="hidden" name="TotalPrice" value="@Model.TotalPrice" />

        <div class="form-group">
            <label for="name">Name:</label>
            <input type="text" id="name" name="Name" value="@Model.Name" required class="form-control" />
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label for="address">Address:</label>
            <input type="text" id="address" name="Address" value="@Model.Address" required class="form-control" />
            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label for="email">Email:</label>
            <input type="email" id="email" name="Email" value="@Model.Email" required class="form-control" />
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary">Complete Purchase</button>
    </form>
    }
    else
    {
    <p class="text-center">No items in your cart to checkout.</p>
    }

    <a href="@Url.Action("product", "ResponseManipulation")" class="btn">Continue Shopping</a>
</main>
</body>
</html>