@{
    ViewData["Title"] = "License Details";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">🔑 License Details</h2>
        </div>
        <div class="card-body">
            @if (ViewBag.LicenseData != null)
            {
                <pre class="p-3 bg-light border rounded">@ViewBag.LicenseData</pre>
            }
            else
            {
                <p class="text-danger">❌ No license data available.</p>
            }
        </div>
        <div class="card-footer text-end">
            <a href="@Url.Action("Dashboard", "SSRF")" class="btn btn-secondary">Back</a>
        </div>
    </div>
</div>

<!-- Bootstrap CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">