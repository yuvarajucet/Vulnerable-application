@{
    ViewData["Title"] = "Login";
    var errorMessage = ViewBag.ErrorMessage != null ? ViewBag.ErrorMessage : "";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="card shadow-lg" style="width: 100%; max-width: 400px;">
        <div class="card-header text-center bg-primary text-white">
            <h4>Login</h4>
        </div>
        <div class="card-body">
            <!-- External Login Buttons -->
            <div class="text-center">
               @await Html.PartialAsync("Secured/Externallogin")
                <p class="mb-3">Or</p>
            </div>
            <hr class="my-4"/>
            <!-- Login Form -->
            <form asp-action="SecuredLogin" method="post">
                <div class="form-group mb-3">
                    <label for="username">Username</label>
                    <input id="username" type="text" name="username" class="form-control" placeholder="Enter your username" required/>
                </div>
                <div class="form-group mb-3">
                    <label for="password">Password</label>
                    <input id="password" type="password" name="password" class="form-control" placeholder="Enter your password" required/>
                </div>
                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>
            <div class="card-body text-center">
                <small class="text-danger">@errorMessage</small>
            </div>

        </div>
        <div class="card-footer text-center">
            <small class="text-muted">Don't have an account? <a href="#">Register here</a></small>
        </div>
    </div>
</div>
