@model IEnumerable<vulnsync.Models.RaceCondition.UserInvite>
@{

    <div class="table-responsive">
        <table class="table table-dark table-hover">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invitedUser in Model)
                {
                    <tr>
                        <td>@invitedUser.Username</td>
                        <td>@invitedUser.Email</td>
                        <td>Pending</td>
                        <td>
                            <button class="btn btn-outline-warning btn-sm" style="color: #ffcc00; border-color: #ffcc00;">
                                Edit
                            </button>
                             <form asp-action="DeleteUserVulnerable" method="POST" style="display:inline;">
                                <input type="hidden" name="username" value="@invitedUser.Username" />
                                <button type="submit" class="btn btn-outline-danger btn-sm" style="color: #ff5e5e; border-color: #ff5e5e;" onclick="return confirm('Are you sure you want to delete this user?');">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card p-4"
                style="background-color: #1f1f1f; color: #eaeaea; border-radius: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);">
                <div class="card-header text-center"
                    style="background-color: #333; color: #ffcc00; border-radius: 8px 8px 0 0;">
                    <h3>User Management</h3>
                </div>
                <div class="card-body">
                    <!-- Add User Form -->
                    <form asp-action="InviteUserVulnerable" method="POST" id="addUserForm" class="mb-4">
                        <div class="row">
                            <div class="col-md-4">
                                <input type="text" name="username" class="form-control" placeholder="Username" required
                                    style="background-color: #444; color: #eaeaea; border: 1px solid #666;">
                            </div>
                            <div class="col-md-4">
                                <input type="email" name="email" class="form-control" placeholder="Email" required
                                    style="background-color: #444; color: #eaeaea; border: 1px solid #666;">
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-outline-success w-100"
                                    style="color: #00ff00; border-color: #00ff00;"
                                    onmouseover="this.style.color='white';" onmouseout="this.style.color='#00ff00';">
                                    Add User
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="card-footer" style="background-color: #2a2a2a; border-radius: 0 0 8px 8px;">
                    <div class="text-danger">@ViewBag.ErrorMessage</div>
                </div>
            </div>
        </div>
    </div>
</div>
