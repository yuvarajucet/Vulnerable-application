@{
    ViewData["Title"] = "Unauthorized Access";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Unauthorized Access
                    </h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="bi bi-shield-lock display-1 text-danger"></i>
                    </div>
                    <h5 class="card-title text-center mb-3">Access Denied</h5>
                    <p class="card-text text-center">
                        @(ViewBag.ErrorMessage ?? "You don't have permission to access this resource.")
                    </p>
                    <div class="text-center mt-4">
                        <a href="@(ViewBag.HomeUrl ?? "/vulnerable/unauthapi")" class="btn btn-primary me-2">
                            <i class="bi bi-house-door me-2"></i>Go to Home
                        </a>
                        <a href="@(ViewBag.RetryUrl ?? "/vulnerable/unauthapi/logout")" class="btn btn-outline-danger">
                            <i class="bi bi-arrow-clockwise me-2"></i>Try Again
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 