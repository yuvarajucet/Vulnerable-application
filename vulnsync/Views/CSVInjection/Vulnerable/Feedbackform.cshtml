<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4" style="background-color: #1f1f1f; color: #eaeaea; border-radius: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);">
                <div class="card-header text-center" style="background-color: #333; color: #ffcc00; border-radius: 8px 8px 0 0;">
                    <h3>Feedback Form</h3>
                </div>
                <div class="card-body">
                    <form asp-action="SubmitFeedback" method="post">
                        <div class="mb-4">
                            <label for="Name" class="form-label">Name</label>
                            <input type="text" id="Name" name="Name" class="form-control" placeholder="Enter your name" required style="background-color: #444; color: #eaeaea; border: 1px solid #666;">
                        </div>
                        <div class="mb-4">
                            <label for="Email" class="form-label">Email</label>
                            <input type="email" id="Email" name="Email" class="form-control" placeholder="Enter your email" required style="background-color: #444; color: #eaeaea; border: 1px solid #666;">
                        </div>
                        <div class="mb-4">
                            <label for="Feedback" class="form-label">Feedback</label>
                            <textarea id="Feedback" name="Feedback" class="form-control" placeholder="Write your feedback" rows="5" required style="background-color: #444; color: #eaeaea; border: 1px solid #666;"></textarea>
                        </div>
                        <button type="submit" class="btn btn-outline-success w-100" style="color: #00ff00; border-color: #00ff00; transition: color 0.3s; text-decoration: none;"
                            onmouseover="this.style.color='white';" onmouseout="this.style.color='#00ff00';">
                            Submit Feedback
                        </button>
                    </form>
                    <button type="button" class="btn btn-outline-secondary w-100 mt-3" onclick="location.href='@Url.Action("AdminPanel", "CSVInjection")'" style="
                    color: #eaeaea; border-color: #666; transition: color 0.3s; text-decoration: none;">
                        Go to Admin Panel
                    </button>
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-info mt-3" role="alert" style="background-color: #333; color: #ffcc00; border: 1px solid #444;">
                            @ViewBag.Message
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
