@model List<VulnSync.Models.XSS.OnlineProduct>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product List - E-Commerce</title>
    <style>
        /* Add basic styling here */
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }
        .container {
            width: 90%;  /* Adjusted width for responsiveness */
            margin: 0 auto;
        }
        header {
            background-color: #333;
            color: white;
            padding: 10px 0;
            text-align: center;
        }
        h1 {
            margin: 0;
        }
        .search-bar {
            margin: 20px 0;
            display: flex;
            justify-content: center;
        }
        .search-bar input {
            padding: 8px;
            width: 300px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        .search-bar button {
            padding: 8px 16px;
            margin-left: 10px;
            background-color: #333;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .search-bar button:hover {
            background-color: #444;
        }
        .product-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); /* Adjusts grid layout for responsiveness */
            gap: 20px;
            margin-top: 20px;
        }
        .product-card {
            background-color: white;
            padding: 20px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            text-align: center;
        }
        .product-card img {
            width: 100%;           /* Ensure the image fills the container */
            height: auto;          /* Let the image adjust its height according to its aspect ratio */
            max-height: 200px;     /* Limit max height to prevent images from getting too large */
            object-fit: contain;   /* Ensure the entire image is visible */
            border-radius: 8px;    /* Rounded corners for the image */
        }
        .product-card h2 {
            font-size: 1.2em;
            margin: 10px 0;
        }
        .product-card p {
            font-size: 1em;
            color: #777;
        }
        .product-card .price {
            font-size: 1.4em;
            font-weight: bold;
            margin: 10px 0;
            color: #333;
        }
        .product-card .rating {
            margin: 10px 0;
            color: #f39c12;
        }
        .product-card a {
            display: inline-block;
            padding: 10px 15px;
            background-color: #333;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }
        .product-card a:hover {
            background-color: #444;
        }
        .search-query-result {
            margin-top: 20px;
            font-size: 1.1em;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <header>
        <h1>Welcome to Our E-Commerce Store</h1>
    </header>

    <div class="container">
        <!-- Search Bar -->
        <div class="search-bar">
            <form method="post" action="@Url.Action("Reflect", "Xss")">
                <input type="text" name="search" placeholder="Search for products" value="@ViewBag.SearchQuery" />
                <button type="submit">Search</button>
            </form>
        </div>

        <!-- Product List -->
        <div class="product-list">
            @foreach (var product in Model)
            {
                <div class="product-card">
                    <!-- Product Image -->
                    <img src="@product.ImageUrl" alt="@product.Name">
                    <!-- Product Name -->
                    <h2>@product.Name</h2>
                    <!-- Product Description -->
                    <p>@product.Description</p>
                    <!-- Product Price -->
                    <div class="price">$@product.Price</div>
                    <!-- Product Rating (Optional) -->
                    <div class="rating">
                        <span>★★★★☆</span>
                    </div>
                    <!-- View Details Button -->
                    <form method="post" action="@Url.Action("Details", "Xss", new { id = product.Id })">
                        <button type="submit">View Details</button>
                    </form>
                </div>
            }
        </div>

        <!-- This section reflects the user's search query as raw HTML -->
        <div class="search-query-result">
            <strong>Search Results for: </strong> @Html.Raw(ViewBag.SearchQuery)
        </div>
    </div>
</body>
</html>
